# Menstruapp — environment variables (Netlify: Site configuration → Environment variables).
# All of them are OPTIONAL. Without them the app works 100% offline on the device; the backend
# features simply stay hidden.

# Web Push (reminders with the app closed). Generate a pair with:  npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:privacy@your-domain.example
VAPID_SUBJECT=mailto:privacy@example.org

# Set to 1 to turn a backend feature off (it disappears from the app).
MENSTRUAPP_DISABLE_SYNC=0
MENSTRUAPP_DISABLE_SHARE=0

# Local development only: "memory" keeps backend data in RAM (scripts/serve.mjs sets it).
# MENSTRUAPP_STORE=memory
