      "short_name": "Registrar",
      "url": "/?source=shortcut#/home?log=today",
      "icons": [{ "src": "/assets/icons/shortcut-log.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Calendario",
