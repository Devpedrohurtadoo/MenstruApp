      "url": "/?source=shortcut#/calendar",
      "icons": [{ "src": "/assets/icons/shortcut-calendar.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Preguntar a Luna",
      "short_name": "Luna",
      "url": "/?source=shortcut#/luna",
      "icons": [{ "src": "/assets/icons/shortcut-luna.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "screenshots": [
